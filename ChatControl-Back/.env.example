# ===========================================
# ChatControl Backend - Variables de entorno
# Copiar a .env y completar valores
# ===========================================

# Base de datos (PostgreSQL - Supabase)
# En Supabase: Project Settings > Database > Connection string (URI). Añade ?sslmode=require al final.
# Si el proyecto está pausado, restáuralo desde el Dashboard antes de migrar.
DATABASE_URL=postgresql://postgres.xtzpdnuhsobjcvltuqjs:DS21-0246813795@aws-1-us-east-1.pooler.supabase.com:6543/postgres
# Servidor
PORT=3001
NODE_ENV=development

# JWT (Auth)
JWT_SECRET=tu-secreto-jwt-muy-seguro-cambiar-en-produccion
JWT_EXPIRES_IN=7d

# Contraseña fija para login MVP (cambiar en producción)
# Login: número de teléfono + esta contraseña
APP_LOGIN_PASSWORD=ChatControl2024!

# WhatsApp Cloud API (Meta)
# Obtener en: https://developers.facebook.com/
WHATSAPP_ACCESS_TOKEN=tu-token-de-whatsapp-business
WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id
# ID de la cuenta de WhatsApp Business (para listar plantillas: GET /{WABA_ID}/message_templates)
WHATSAPP_BUSINESS_ACCOUNT_ID=tu-waba-id
WHATSAPP_VERIFY_TOKEN=token-para-verificar-webhook
# Modo sandbox (pruebas): solo números autorizados en Meta pueden recibir mensajes. En producción usar false o omitir.
WHATSAPP_SANDBOX=true

# Google Gemini API (crear API key en https://aistudio.google.com/apikey con la misma cuenta)
GEMINI_API_KEY=tu-api-key-de-gemini
# Opcional: modelo (por defecto gemini-2.5-flash). Si da 404 probar GEMINI_MODEL=gemini-pro
# GEMINI_MODEL=gemini-2.5-flash

# TODO: Futuro multi-empresa - cada empresa tendrá su propio token de IA
# GEMINI_API_KEY por tenant/empresa en BD
