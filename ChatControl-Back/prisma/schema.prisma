generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String                   @id @default(cuid())
  name                  String
  status                OrganizationStatus       @default(ACTIVE)
  /// ID del número en Meta (metadata.phone_number_id). Índice para enrutar webhooks.
  whatsappPhoneNumberId String?                  @unique
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @default(now()) @updatedAt
  contacts              Contact[]
  credentials           OrganizationCredentials?
  orgSettings           OrganizationSetting[]
  templates             Template[]
  users                 User[]
}

/// Credenciales sensibles cifradas (AES-256-GCM). Solo el backend descifra.
model OrganizationCredentials {
  organizationId               String       @id
  whatsappAccessTokenEnc       String?
  whatsappBusinessAccountIdEnc String?
  geminiApiKeyEnc              String?
  updatedAt                    DateTime     @default(now()) @updatedAt
  organization                 Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Ajustes por empresa (modelo Gemini, tier, etc.)
model OrganizationSetting {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  value          String
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  displayName       String?
  role              UserRole
  organizationId    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  messagesSent          Message[]          @relation("MessageSentBy")
  platformAuditLogs     PlatformAuditLog[]
  organization          Organization?      @relation(fields: [organizationId], references: [id])
  assignedConversations Conversation[]     @relation("ConversationAssigned")

  @@index([organizationId])
  @@index([email])
}

/// Acciones del super admin sobre la plataforma (crear/suspender empresa, etc.).
model PlatformAuditLog {
  id                   String   @id @default(cuid())
  actorUserId          String
  action               String
  targetOrganizationId String?
  metadata             Json?
  createdAt            DateTime @default(now())
  actor                User     @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([targetOrganizationId])
  @@index([createdAt(sort: Desc)])
}

model Contact {
  id                  String         @id @default(cuid())
  phone               String
  createdAt           DateTime       @default(now())
  isSandboxAuthorized Boolean        @default(false)
  name                String?
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations       Conversation[]

  @@unique([organizationId, phone])
  @@index([phone])
}

model Conversation {
  id                String    @id @default(cuid())
  contactId         String
  lastUserMessageAt DateTime?
  createdAt         DateTime  @default(now())
  lastReadAt        DateTime?
  isNewLead         Boolean   @default(false)
  assignedToUserId  String?
  assignedAt        DateTime?
  autoMessageDetectedAt DateTime?
  contact           Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages          Message[]
  assignedToUser    User?     @relation("ConversationAssigned", fields: [assignedToUserId], references: [id])

  @@index([contactId])
  @@index([contactId, createdAt(sort: Desc)])
  @@index([assignedToUserId])
  @@index([isNewLead])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  status            MessageStatus    @default(SENT)
  body              String
  whatsappMessageId String           @unique
  whatsappTimestamp DateTime
  fromAi            Boolean?         @default(false)
  createdAt         DateTime         @default(now())
  fileName          String?
  mediaUrl          String?
  mimeType          String?
  sentByUserId      String?
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentByUser        User?            @relation("MessageSentBy", fields: [sentByUserId], references: [id])

  @@index([conversationId])
  @@index([conversationId, whatsappTimestamp])
  @@index([whatsappMessageId])
  @@index([sentByUserId])
}

model BroadcastLog {
  id             String   @id @default(cuid())
  conversationId String
  type           String
  status         String
  errorMessage   String?
  createdAt      DateTime @default(now())
  organizationId String?
  userId         String?

  @@index([conversationId])
  @@index([organizationId])
  @@index([createdAt(sort: Desc)])
}

/// Configuración global legacy (tier, modelo por defecto). Preferir OrganizationSetting por tenant.
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}

model Template {
  id             String       @id @default(cuid())
  name           String
  body           String
  variables      String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([name])
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  AGENT
}

enum MessageDirection {
  IN
  OUT
}

enum MessageType {
  TEXT
  TEMPLATE
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum MessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}
