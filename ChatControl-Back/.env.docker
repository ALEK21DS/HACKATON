# Copia este archivo como .env o úsalo con docker-compose directly.
# Reemplaza los valores de abajo según tu entorno.

DATABASE_URL=postgresql://chatcontrol:chatcontrol@db:5432/chatcontrol?sslmode=disable
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
ENCRYPTION_MASTER_KEY=replace-with-a-32+char-secret-key
WHATSAPP_VERIFY_TOKEN=replace-with-whatsapp-verify-token

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
